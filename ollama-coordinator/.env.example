OLLAMA_COORDINATOR_UPSTREAM_URL=http://127.0.0.1:11434
OLLAMA_COORDINATOR_PORT=11435
# install.sh fills this with Docker's private bridge gateway when available.
OLLAMA_COORDINATOR_DOCKER_BIND_HOST=
OLLAMA_COORDINATOR_DOCUMENT_MODEL=qwen3-vl:8b-instruct
OLLAMA_COORDINATOR_ASK_MODEL=deepseek-r1:8b
OLLAMA_COORDINATOR_DOCUMENT_MAX_NUM_CTX=16384
OLLAMA_COORDINATOR_DOCUMENT_MAX_NUM_PREDICT=6000
OLLAMA_COORDINATOR_ASK_MAX_NUM_CTX=8192
OLLAMA_COORDINATOR_ASK_MAX_NUM_PREDICT=1000
OLLAMA_COORDINATOR_MAX_PENDING=2
OLLAMA_COORDINATOR_MAX_BODY_BYTES=67108864
OLLAMA_COORDINATOR_MAX_RESPONSE_BYTES=16777216
OLLAMA_COORDINATOR_MAX_QUEUE_WAIT_SECONDS=120
OLLAMA_COORDINATOR_MAX_REQUEST_SECONDS=1800
OLLAMA_COORDINATOR_KEEP_ALIVE=5m
OLLAMA_COORDINATOR_LOCK_PATH=/run/ollama-inference-coordinator/coordinator.lock
LOG_LEVEL=INFO
