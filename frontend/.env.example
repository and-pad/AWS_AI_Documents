## Valores de ejemplo: reemplazarlos por los Outputs del stack desplegado en us-east-2.
VITE_API_BASE_URL=https://your-api-id.execute-api.us-east-2.amazonaws.com/dev
VITE_COGNITO_USER_POOL_ID=us-east-2_example
VITE_COGNITO_USER_POOL_CLIENT_ID=examplepublicclientid
# Solo para LocalStack con Cognito habilitado: http://cognito-idp.localhost.localstack.cloud:4566
# VITE_COGNITO_ENDPOINT=http://cognito-idp.localhost.localstack.cloud:4566
